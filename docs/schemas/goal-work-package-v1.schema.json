{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sila.dev/schemas/goal-work-package-v1.schema.json",
  "title": "WorkPackage",
  "description": "Canonical typed specification for Sila v1 task execution contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_slug",
    "revision",
    "purpose",
    "constraints",
    "non_goals",
    "tasks",
    "acceptance",
    "dependency_conditions",
    "unresolved_decisions",
    "retired_task_ids",
    "retired_acceptance_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "sila/work-package/v1"
    },
    "goal_slug": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/TaskContract" }
    },
    "acceptance": {
      "type": "array",
      "items": { "$ref": "#/definitions/AcceptanceCase" }
    },
    "dependency_conditions": {
      "type": "array",
      "items": { "$ref": "#/definitions/DependencyCondition" }
    },
    "unresolved_decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "retired_task_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^T-[0-9]+$" }
    },
    "retired_acceptance_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^AC-[0-9]+$" }
    }
  },
  "definitions": {
    "TaskContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "context",
        "why",
        "depends_on",
        "files",
        "references",
        "decisions",
        "steps",
        "interfaces",
        "constraints",
        "examples",
        "acceptance_ids",
        "checks",
        "stop_conditions",
        "return_format"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T-[0-9]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files": { "$ref": "#/definitions/TaskFiles" },
        "references": {
          "type": "array",
          "items": { "$ref": "#/definitions/Reference" }
        },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/definitions/Decision" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/Step" }
        },
        "interfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/definitions/Example" }
        },
        "acceptance_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^AC-[0-9]+$" }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/definitions/Check" }
        },
        "stop_conditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "return_format": {
          "type": "string",
          "const": "sila/task-result/v1"
        }
      }
    },
    "TaskFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "edit", "create", "forbid"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" } },
        "edit": { "type": "array", "items": { "type": "string" } },
        "create": { "type": "array", "items": { "type": "string" } },
        "forbid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol", "excerpt", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "symbol": { "type": "string" },
        "excerpt": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chosen", "rationale", "rejected"],
      "properties": {
        "id": { "type": "string", "pattern": "^D-[0-9]+$" },
        "chosen": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "rejected": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "expected", "on_failure"],
      "properties": {
        "id": { "type": "string", "pattern": "^S-[0-9]+$" },
        "action": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "on_failure": { "type": "string", "minLength": 1 }
      }
    },
    "Example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "explanation"],
      "properties": {
        "input": { "type": "string" },
        "output": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    "AcceptanceCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement",
        "given",
        "action",
        "expected",
        "required_scope",
        "mandatory",
        "check_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
        "requirement": { "type": "string", "minLength": 1 },
        "given": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "required_scope": {
          "type": "string",
          "enum": ["unit", "integration", "browser", "provider", "manual"]
        },
        "mandatory": { "type": "boolean" },
        "check_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^C-[0-9]+$" }
        }
      }
    },
    "Check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "executable",
        "args",
        "cwd",
        "timeout_seconds",
        "expected_exit_code",
        "scope",
        "assertions",
        "capability",
        "environment"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^C-[0-9]+$" },
        "executable": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "expected_exit_code": { "type": "integer" },
        "scope": {
          "type": "string",
          "enum": ["unit", "integration", "browser", "provider", "manual"]
        },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/definitions/Assertion" }
        },
        "capability": {
          "type": "string",
          "enum": ["local", "provider", "manual"]
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "Assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "expected"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["go_test_pass", "stdout_exact", "json_pointer_equals"]
        },
        "target": { "type": "string", "minLength": 1 },
        "expected": {}
      }
    },
    "DependencyCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "goal_slug"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "accepted_goal",
            "accepted_task",
            "artifact_digest",
            "decision_equals"
          ]
        },
        "goal_slug": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "pattern": "^T-[0-9]+$" },
        "artifact": { "type": "string" },
        "sha256": { "type": "string" },
        "pointer": { "type": "string" },
        "equals": {}
      }
    }
  }
}
