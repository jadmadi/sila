{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sila.dev/schemas/task-evidence-v1.schema.json",
  "title": "TaskEvidence",
  "description": "Canonical typed specification for Sila v1 task execution evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "goal_slug",
    "task_id",
    "case_id",
    "check_id",
    "spec_digest",
    "packet_digest",
    "candidate",
    "scope",
    "outcome",
    "origin",
    "executable",
    "args",
    "cwd",
    "exit_code",
    "assertions",
    "artifacts",
    "started_at",
    "ended_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "sila/task-evidence/v1"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_slug": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^AC-[0-9]+$"
    },
    "check_id": {
      "type": "string",
      "pattern": "^C-[0-9]+$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate": {
      "$ref": "#/definitions/TaskCandidate"
    },
    "scope": {
      "type": "string",
      "enum": ["unit", "integration", "browser", "provider", "manual"]
    },
    "outcome": {
      "type": "string",
      "enum": ["pass", "fail", "blocked", "not_run"]
    },
    "origin": {
      "type": "string",
      "enum": ["runner", "imported"]
    },
    "executable": {
      "type": "string"
    },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cwd": {
      "type": "string"
    },
    "exit_code": {
      "type": ["integer", "null"]
    },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/definitions/AssertionObservation" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/EvidenceArtifact" }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure_code": {
      "type": "string"
    },
    "observation": {
      "type": "object"
    }
  },
  "definitions": {
    "TaskCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "content_digest", "tool_versions", "os", "arch"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "content_digest": { "type": "string", "minLength": 1 },
        "tool_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "AssertionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "expected", "observed", "passed"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["go_test_pass", "stdout_exact", "json_pointer_equals"]
        },
        "target": { "type": "string", "minLength": 1 },
        "expected": {},
        "observed": {},
        "passed": { "type": "boolean" }
      }
    },
    "EvidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
